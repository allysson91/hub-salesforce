PORT=3000

VIACEP_BASE_URL=https://viacep.com.br/ws

# Use DATABASE_URL para banco em nuvem, como Neon.
# Quando DATABASE_URL estiver definida, ela tem prioridade sobre DB_HOST/DB_PORT/etc.
DATABASE_URL=
DB_SSL=false

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=hub_salesforce

HUB_OAUTH_CLIENT_ID=salesforce-client
HUB_OAUTH_CLIENT_SECRET=change-this-secret
HUB_JWT_SECRET=change-this-jwt-secret
HUB_ACCESS_TOKEN_EXPIRES_IN=3600

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
